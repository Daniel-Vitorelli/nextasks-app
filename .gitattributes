# Normaliza fim de linha: LF no repositório.
#
# Importante neste projeto: `tools/limpar-versao.sh` roda no bash e com CRLF
# falha com "bad interpreter". Os .cmd do Windows continuam em CRLF.
* text=auto eol=lf

*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.ttf binary
*.otf binary
*.jar binary
*.apk binary
*.aab binary
